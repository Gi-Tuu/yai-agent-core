# 复制为 .env 后填写；.env 已被 .gitignore 排除，不会进仓库
# OpenAI 兼容端点（DeepSeek 示例；通义千问等同样适用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 复杂/规划任务使用的强模型（可选，缺省与 LLM_MODEL 相同）
LLM_STRONG_MODEL=deepseek-chat

# X-Agent 部署验证（batteries/fastapi_server 读取）
YAI_PROJECT_SLUG=team-project
YAI_GIT_COMMIT=
